{
	"name": "paypal-donations",
	"version": "2.0.0",
	"title": "PayPal Donations",
	"description": "A PayPal donation button as a shortcode ([paypal-donation]) and a widget. With IPN turned on, donations are checked with PayPal and listed in the admin.",
	"author": "GoPress",
	"api": 1,
	"permissions": {
		"http": [
			"ipnpb.paypal.com",
			"ipnpb.sandbox.paypal.com"
		],
		"routes": [
			"/ipn"
		],
		"legacy_routes": [
			{
				"query": {
					"ppd_paypal_ipn": "process"
				},
				"route": "/ipn"
			}
		],
		"data": [
			"import:option:paypal_donations_options",
			"import:post:donation_list",
			"mail:admins",
			"notify:admins"
		]
	},
	"shortcodes": [
		{
			"name": "paypal-donation"
		}
	],
	"widgets": [
		{
			"type": "paypal_donations",
			"title": "PayPal Donations",
			"description": "A donation button with an optional text.",
			"fields": [
				{
					"name": "title",
					"label": "Title",
					"max_length": 200
				},
				{
					"name": "text",
					"label": "Text",
					"type": "textarea",
					"max_length": 2000
				},
				{
					"name": "purpose",
					"label": "Purpose",
					"max_length": 127
				},
				{
					"name": "reference",
					"label": "Reference",
					"max_length": 127
				}
			]
		}
	],
	"admin": [
		{
			"id": "settings",
			"title": "PayPal Donations",
			"menu": "settings",
			"capability": "manage_options",
			"kind": "settings",
			"fields": [
				{
					"name": "paypal_account",
					"label": "PayPal account",
					"help": "The email address or merchant ID of the PayPal account that receives donations.",
					"required": true,
					"max_length": 127
				},
				{
					"name": "currency_code",
					"label": "Currency",
					"type": "select",
					"options": [
						{
							"value": "AUD",
							"label": "Australian Dollars (A $)"
						},
						{
							"value": "BRL",
							"label": "Brazilian Real"
						},
						{
							"value": "CAD",
							"label": "Canadian Dollars (C $)"
						},
						{
							"value": "CZK",
							"label": "Czech Koruna"
						},
						{
							"value": "DKK",
							"label": "Danish Krone"
						},
						{
							"value": "EUR",
							"label": "Euros (€)"
						},
						{
							"value": "HKD",
							"label": "Hong Kong Dollar ($)"
						},
						{
