					"default": "USD"
				},
				{
					"name": "page_style",
					"label": "Page style",
					"help": "Name of a custom payment page style of your PayPal account (optional).",
					"max_length": 30
				},
				{
					"name": "return_page",
					"label": "Return page",
					"type": "url",
					"help": "Where PayPal sends donors afterwards, e.g. a thank-you page (optional)."
				},
				{
					"name": "amount",
					"label": "Default amount",
					"type": "number",
					"min": 0,
					"max": 100000,
					"help": "0 lets donors enter the amount."
				},
				{
					"name": "purpose",
					"label": "Default purpose",
					"max_length": 127
				},
				{
