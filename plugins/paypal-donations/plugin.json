				{
					"name": "ipn_enabled",
					"label": "Record donations (PayPal IPN)",
					"type": "checkbox",
					"help": "PayPal reports each donation to this site, which checks it with PayPal and lists it under Donations. Turn on IPN in your PayPal account too."
