							"label": "Mexican Peso"
						},
						{
							"value": "NOK",
							"label": "Norwegian Krone"
						},
						{
							"value": "NZD",
							"label": "New Zealand Dollar ($)"
						},
						{
							"value": "PHP",
							"label": "Philippine Peso"
						},
						{
							"value": "PLN",
							"label": "Polish Zloty"
						},
						{
							"value": "GBP",
